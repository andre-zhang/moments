# =============================================================================
# Anthropic (server only) — optional “trip recap” & place tips
# =============================================================================
ANTHROPIC_API_KEY=
# Optional override; default is a small fast model
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# =============================================================================
# Neon Postgres — server only (Vercel: Project Settings → Environment Variables)
# Paste your connection string from the Neon dashboard.
# =============================================================================
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Shared secret so only your deployed app can read/write state and photos.
# Use a long random string (e.g. openssl rand -hex 32).
# Set the SAME value in Vercel for MOMENTS_SYNC_SECRET and below for VITE_*.
MOMENTS_SYNC_SECRET=

# =============================================================================
# Vite / browser (required at build time on Vercel for production deploys)
# Add these in Vercel too — same secret as MOMENTS_SYNC_SECRET.
# =============================================================================
VITE_MOMENTS_SYNC_SECRET=

# Optional: API origin. Leave unset on Vercel (same-origin /api/*).
# Local: run `vercel dev` in this folder, then set e.g. VITE_API_BASE=http://127.0.0.1:3000
# VITE_API_BASE=http://127.0.0.1:3000
